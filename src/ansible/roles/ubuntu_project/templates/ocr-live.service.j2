[Unit]
Description=OCR-APT live detection server (follows Loki, scores windows)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User={{ ansible_user }}
WorkingDirectory={{ repo_dest }}
# print the [live] lines to journalctl immediately (systemd allows no comment after a value)
Environment=PYTHONUNBUFFERED=1
# Mirrors serve.sh, but binds {{ server_bind }} (all interfaces) so it listens on the subnet IP.
# Model = the repo's current-model pointer (`lab promote <run>`, then `sudo systemctl restart ocr-live`).
# LLM flags = live_llm_args (empty = LLM off); the key comes from ~/.config/nt2102/credentials.json.
ExecStart=/usr/local/bin/uv run {{ '--group llm ' if live_llm_args | default('') else '' }}python src/live/live_server.py --bind {{ server_bind }} --port {{ server_port }} --loki-url http://127.0.0.1:{{ loki_port }}{{ ' ' + live_llm_args if live_llm_args | default('') else '' }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
