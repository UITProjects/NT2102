[Unit]
Description=OCR-APT live detection server (follows Loki, scores windows)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User={{ ansible_user }}
WorkingDirectory={{ repo_dest }}
Environment=PYTHONUNBUFFERED=1   # print the [live] lines to journalctl immediately
# Mirrors serve.sh, but binds {{ server_bind }} (all interfaces) so it listens on the subnet IP.
# Model = the repo's current-model pointer (`lab promote <run>`, then `sudo systemctl restart ocr-live`).
ExecStart=/usr/local/bin/uv run python src/live/live_server.py --bind {{ server_bind }} --port {{ server_port }} --loki-url http://127.0.0.1:{{ loki_port }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
