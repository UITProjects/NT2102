#Requires -RunAsAdministrator
<#
  start-live.ps1 (generated by Ansible: win_shipper role)

  Start a live SilkETW capture (split "test", run live-<UTC>). Nothing is shipped by this script: Grafana
  Alloy tails the run folder and pushes every line to Loki ({{ loki_url }}); the live server on the
  trainer follows the newest test run in Loki. Conversion, windowing and scoring all run on the trainer.

  Run in an ELEVATED PowerShell during the demo:
      C:\scripts\start-live.ps1                 # new capture; press Ctrl+C to stop it
      C:\scripts\start-live.ps1 -Minutes 30     # stop by itself after 30 minutes
  Live UI: http://{{ trainer_host }}:{{ server_port }}/   Grafana: http://{{ trainer_host }}:{{ grafana_port }}/

  PowerShell notes: try { } finally { } runs the finally block on Ctrl+C too, so the capture is always
  stopped; Get-Service reads a service's state; Start-Sleep waits N seconds.
#>
param(
    [int] $Minutes = 0          # 0 = until Ctrl+C
)
$ErrorActionPreference = 'Stop'

$LabDir = '{{ lab_home }}'
$Cfg    = Get-Content (Join-Path $LabDir 'etwlab.json') -Raw | ConvertFrom-Json
$Etwctl = Join-Path $LabDir 'etwctl.ps1'

if ((Get-Service Alloy).Status -ne 'Running') { throw "the Alloy service is not running: nothing would reach Loki" }
$svc = Get-Service $Cfg.ServiceName
if ($svc.Status -ne 'Stopped') { throw "$($Cfg.ServiceName) is $($svc.Status). Run 'etwctl stop' first." }

$run = 'live-' + (Get-Date).ToUniversalTime().ToString("yyyyMMdd'T'HHmmss'Z'")
& powershell -NoProfile -ExecutionPolicy Bypass -File $Etwctl start -Split test -Run $run
if ($LASTEXITCODE -ne 0) { throw "etwctl start failed (exit $LASTEXITCODE)" }

Write-Host "[start-live] capturing test/$run; Alloy ships it to {{ loki_url }}. Ctrl+C stops the capture."
try {
    $until = if ($Minutes -gt 0) { (Get-Date).AddMinutes($Minutes) } else { [datetime]::MaxValue }
    while ((Get-Date) -lt $until) { Start-Sleep -Seconds 5 }
} finally {
    & powershell -NoProfile -ExecutionPolicy Bypass -File $Etwctl stop
    Write-Host "[start-live] stopped. Alloy keeps shipping the last lines for a few seconds."
}
