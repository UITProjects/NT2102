#Requires -RunAsAdministrator
<#
  start-live.ps1 (generated by Ansible: win_shipper role)

  Keeps a live SilkETW capture (split "test", run live-<UTC>) ALWAYS running. Nothing is shipped by this
  script: Grafana Alloy tails the run folder and pushes every line to Loki ({{ loki_url }}); the live server
  on the trainer follows the newest test run in Loki. The capture itself runs inside the SilkService Windows
  service; this script only decides WHEN to start a fresh run, because SilkService reads its output folder
  once at service start (a plain auto-start would append to the last run, possibly a training run).

  The scheduled task "{{ live_task_name }}" (SYSTEM, at boot + every {{ live_watchdog_minutes }} min) runs it
  with no arguments = one watchdog tick:
    - a hold file exists ({{ lab_home }}\live.hold)  -> do nothing (07-build-train-dataset.ps1 or -Pause)
    - a TRAIN capture or a non-live test run is running -> do nothing
    - a live-* run older than {{ live_rotate_hours }} h is running -> stop it and start a new live-<UTC>
    - nothing is running                             -> start a new live-<UTC>
    - delete raw\test\live-* runs with no write for {{ live_keep_days }} days (never raw\train, never the current run)
  Each action is one line in {{ lab_home }}\live-watchdog.log.

  By hand (elevated PowerShell):
      C:\scripts\start-live.ps1 -Status    # service state, current run, hold, last log lines
      C:\scripts\start-live.ps1 -Rotate    # start a fresh live run now (clean session before a demo)
      C:\scripts\start-live.ps1 -Pause     # stop the live capture and keep it stopped (hold file)
      C:\scripts\start-live.ps1 -Resume    # remove the hold; the capture restarts now
  Live UI: http://{{ trainer_host }}:{{ server_port }}/   Grafana: http://{{ trainer_host }}:{{ grafana_port }}/

  PowerShell notes: Get-Service reads a service's state; a [switch] parameter is a flag that is either given
  or not; ConvertFrom-Json / ConvertTo-Json read / write JSON; Add-Content appends a line to a file; a
  System.Threading.Mutex is a machine-wide lock, so a manual call and a task tick never act at the same time.
#>
param(
    [switch] $Rotate,
    [switch] $Pause,
    [switch] $Resume,
    [switch] $Status
)
$ErrorActionPreference = 'Stop'

$LabDir   = '{{ lab_home }}'
$Cfg      = Get-Content (Join-Path $LabDir 'etwlab.json') -Raw | ConvertFrom-Json
$Etwctl   = Join-Path $LabDir 'etwctl.ps1'
$StateF   = Join-Path $LabDir 'state.json'          # written by etwctl: split, run, dir, started_utc, stopped_utc
$HoldF    = Join-Path $LabDir 'live.hold'           # {pid, by, since_utc}; pid 0 = manual hold, never stale
$LogF     = Join-Path $LabDir 'live-watchdog.log'
$RotateH  = {{ live_rotate_hours }}
$KeepDays = {{ live_keep_days }}

function Log($msg) {
    $line = (Get-Date).ToUniversalTime().ToString("yyyy-MM-dd'T'HH:mm:ss'Z'") + " $msg"
    Add-Content -Path $LogF -Value $line
    Write-Host $line
}
function Get-State { if (Test-Path $StateF) { Get-Content $StateF -Raw | ConvertFrom-Json } else { $null } }

# Hold file: returns its content, or $null. A hold whose writer process is gone (07 crashed) is removed.
function Get-Hold {
    if (-not (Test-Path $HoldF)) { return $null }
    $h = Get-Content $HoldF -Raw | ConvertFrom-Json
    if ($h.pid -ne 0 -and -not (Get-Process -Id $h.pid -ErrorAction SilentlyContinue)) {
        Remove-Item $HoldF -Force
        Log "removed stale hold (by $($h.by), pid $($h.pid) no longer running)"
        return $null
    }
    return $h
}

# Run etwctl in a child PowerShell (as the old start-live did); its output goes to the log.
# 'Continue' here: in Windows PowerShell 5.1, 2>&1 on a native program turns its stderr lines into errors,
# which 'Stop' would make fatal. We judge success by the exit code instead.
function Invoke-Etwctl([string[]] $EtwArgs) {
    $ErrorActionPreference = 'Continue'
    $out = & powershell -NoProfile -ExecutionPolicy Bypass -File $Etwctl @EtwArgs 2>&1 | Out-String
    $code = $LASTEXITCODE
    Add-Content -Path $LogF -Value ($out.TrimEnd() -split "`r?`n" | ForEach-Object { "    $_" })
    return $code
}

function Start-LiveRun {
    $run  = 'live-' + (Get-Date).ToUniversalTime().ToString("yyyyMMdd'T'HHmmss'Z'")
    $code = Invoke-Etwctl @('start', '-Split', 'test', '-Run', $run)
    if ($code -eq 0) { Log "started test/$run" } else { Log "etwctl start test/$run exited $code (see lines above)" }
}

function Test-LiveRunning($svc, $st) {
    return ($svc.Status -eq 'Running' -and $st -and $st.split -eq 'test' -and "$($st.run)" -like 'live-*')
}

# etwctl writes started_utc with ToString("o"); 5.1's ConvertFrom-Json keeps it a string, 7+ makes a DateTime.
function Get-StartedUtc($st) {
    if ($st.started_utc -is [datetime]) { return $st.started_utc.ToUniversalTime() }
    return [datetime]::Parse("$($st.started_utc)", [Globalization.CultureInfo]::InvariantCulture,
                             [Globalization.DateTimeStyles]::RoundtripKind).ToUniversalTime()
}

# Raw live runs with no write for $KeepDays days. Alloy keeps the lines in Loki (its own retention).
function Remove-OldLiveRuns($currentRun) {
    $testDir = Join-Path $Cfg.RawRoot 'test'
    if (-not (Test-Path $testDir)) { return }
    $cut = (Get-Date).ToUniversalTime().AddDays(-$KeepDays)
    foreach ($d in Get-ChildItem $testDir -Directory -Filter 'live-*') {
        if ($d.Name -eq $currentRun) { continue }
        $newest = Get-ChildItem $d.FullName -File -Recurse -ErrorAction SilentlyContinue |
                  Sort-Object LastWriteTimeUtc -Descending | Select-Object -First 1
        $last = if ($newest) { $newest.LastWriteTimeUtc } else { $d.LastWriteTimeUtc }
        if ($last -lt $cut) {
            try { Remove-Item $d.FullName -Recurse -Force; Log "deleted raw test/$($d.Name) (last write $($last.ToString('o')))" }
            catch { Log "could not delete raw test/$($d.Name): $($_.Exception.Message) (retry next tick)" }
        }
    }
}

function Show-LiveStatus($svc, $st) {
    Write-Host "service : $($svc.Name) = $($svc.Status)"
    if ($st) { Write-Host "run     : $($st.split)/$($st.run)  started $($st.started_utc)  stopped $($st.stopped_utc)" }
    $h = Get-Hold
    Write-Host ("hold    : " + $(if ($h) { "yes (by $($h.by) since $($h.since_utc))" } else { "no" }))
    $t = Get-ScheduledTask -TaskName '{{ live_task_name }}' -ErrorAction SilentlyContinue
    Write-Host ("task    : " + $(if ($t) { "{{ live_task_name }} = $($t.State)" } else { "MISSING" }))
    Write-Host "alloy   : $((Get-Service Alloy).Status)"
    if (Test-Path $LogF) { Write-Host "log     : last lines of $LogF"; Get-Content $LogF -Tail 8 | ForEach-Object { "    $_" } }
}

# The whole decision, as a function so every early exit is a plain `return` (the mutex is released below).
function Invoke-Main {
    $rot = [bool]$Rotate
    $svc = Get-Service $Cfg.ServiceName
    $st  = Get-State

    if ($Status) { Show-LiveStatus $svc $st; return }

    if ($Pause) {
        $hold = [ordered]@{ pid = 0; by = 'start-live.ps1 -Pause'; since_utc = (Get-Date).ToUniversalTime().ToString('o') }
        Set-Content -Path $HoldF -Value ($hold | ConvertTo-Json -Compress)
        if (Test-LiveRunning $svc $st) { [void](Invoke-Etwctl @('stop')); Log "paused: stopped test/$($st.run)" }
        else { Log "paused (no live run was running)" }
        return
    }

    if ($Resume) {
        if (Test-Path $HoldF) { Remove-Item $HoldF -Force; Log "resumed: hold removed" }
        $rot = $false                     # continue as a normal tick, which starts a run if none is running
    }

    if ((Get-Service Alloy).Status -ne 'Running') { Log "WARNING the Alloy service is not running: nothing reaches Loki" }

    $hold = Get-Hold
    if ($hold) {
        if ($rot) { Write-Host "[start-live] on hold (by $($hold.by)); run with -Resume first" }
        return
    }
    if ($svc.Status -eq 'Running' -and $st -and -not (Test-LiveRunning $svc $st)) {
        if ($rot) { Write-Host "[start-live] $($st.split)/$($st.run) is capturing (not a live run); not touching it" }
        return                            # a training capture or a hand-started test run
    }
    if ($svc.Status -ne 'Running' -and $svc.Status -ne 'Stopped') { return }   # StartPending / StopPending: next tick

    if (Test-LiveRunning $svc $st) {
        $age = (Get-Date).ToUniversalTime() - (Get-StartedUtc $st)
        if ($rot -or $age.TotalHours -ge $RotateH) {
            [void](Invoke-Etwctl @('stop'))
            Log ("rotated: stopped test/$($st.run) after {0:N1} h" -f $age.TotalHours)
            Start-LiveRun
        }
    } else {
        Start-LiveRun                     # SilkService is stopped and nothing holds it
    }

    $cur = Get-State
    Remove-OldLiveRuns $(if ($cur) { "$($cur.run)" } else { '' })
}

# One action at a time on this machine (task tick vs a manual call). An "abandoned" mutex (a previous run was
# killed while holding it) is still ours once WaitOne throws AbandonedMutexException.
$mutex = New-Object System.Threading.Mutex($false, 'Global\etwlab-live')
try { $owned = $mutex.WaitOne(0) } catch [System.Threading.AbandonedMutexException] { $owned = $true }
if (-not $owned) { Write-Host "[start-live] another start-live.ps1 is running; try again in a few seconds"; exit 0 }
try { Invoke-Main } finally { $mutex.ReleaseMutex() }
