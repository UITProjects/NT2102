#Requires -RunAsAdministrator
<#
  ship-live.ps1 (generated by Ansible: win_shipper role)

  Start a live SilkETW capture and stream it to the OCR-APT live server on the Ubuntu trainer.
  Conversion, windowing, features and scoring all run on the trainer (engine.py); the VM only tails
  the raw JSON files and POSTs them.

  Run in an ELEVATED PowerShell during the demo:
      C:\scripts\ship-live.ps1                 # new capture, ship it to the trainer
      C:\scripts\ship-live.ps1 -NoCapture      # ship the capture that is already running
  Stop with Ctrl+C (offsets are saved; the capture this script started is stopped).

  Server target (from the Ansible inventory): http://{{ trainer_host }}:{{ server_port }}
#>
param(
    [string] $Server = '{{ trainer_host }}',
    [int]    $Port   = {{ server_port }},
    [string] $Token  = '',
    [switch] $NoCapture
)
$ErrorActionPreference = 'Stop'

$LabDir = '{{ lab_home }}'
$Cfg    = Get-Content (Join-Path $LabDir 'etwlab.json') -Raw | ConvertFrom-Json
$Etwctl = Join-Path $LabDir 'etwctl.ps1'
$Ship   = Join-Path $LabDir 'etwship.py'

if (-not $NoCapture) {
    $svc = Get-Service $Cfg.ServiceName
    if ($svc.Status -ne 'Stopped') {
        throw "$($Cfg.ServiceName) is $($svc.Status). Run 'etwctl stop' first, or use -NoCapture."
    }
    $run = 'live-' + (Get-Date).ToUniversalTime().ToString("yyyyMMdd'T'HHmmss'Z'")
    & powershell -NoProfile -ExecutionPolicy Bypass -File $Etwctl start -Split test -Run $run
    if ($LASTEXITCODE -ne 0) { throw "etwctl start failed (exit $LASTEXITCODE)" }
}

# etwctl records the current run folder in state.json.
$state = Get-Content (Join-Path $LabDir 'state.json') -Raw | ConvertFrom-Json
$PyArgs = @($Ship, '--dir', $state.dir, '--server', "http://${Server}:$Port")
if ($Token) { $PyArgs += @('--token', $Token) }

Write-Host "[ship-live] $($state.dir) -> http://${Server}:$Port"
try {
    & $Cfg.Python @PyArgs
} finally {
    if (-not $NoCapture) {
        & powershell -NoProfile -ExecutionPolicy Bypass -File $Etwctl stop
    }
}
