#!/usr/bin/env python3
"""labctl - start/stop/status Sysmon-for-Linux capture runs on the Linux target.

The Linux counterpart of etwctl.ps1 on the Windows collector. Sysmon runs continuously as a service; a
"capture run" here just directs its syslog output into a per-run file so Alloy can tag it with split/run,
exactly like SilkService writing raw\\<split>\\<run>\\<provider>.json on Windows.

    labctl start --split train|test [--run NAME]   point the current-run symlink at a new run dir
    labctl stop                                    record the stop time
    labctl status                                  current run + file size

Layout:  {raw_root}/<split>/<run>/sysmon.log   (rsyslog writes here via the `current` symlink)
         {raw_root}/current -> <split>/<run>    (labctl repoints this; rsyslog reloads to reopen the file)
"""
import argparse, datetime, json, os, shutil, subprocess, sys

RAW_ROOT = os.environ.get("LAB_RAW_ROOT", "/var/lib/etwlab/raw")
CURRENT = os.path.join(RAW_ROOT, "current")
STATE = os.path.join(RAW_ROOT, "state.json")


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_state():
    try:
        with open(STATE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def write_state(obj):
    with open(STATE, "w") as fh:
        json.dump(obj, fh)


def reload_rsyslog():
    # rsyslog reopens its output files on restart; this makes it write into the newly-pointed run dir.
    subprocess.run(["systemctl", "restart", "rsyslog"], check=True)


def cmd_start(a):
    run = a.run or datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    run_dir = os.path.join(RAW_ROOT, a.split, run)
    if os.path.exists(run_dir):
        sys.exit(f"run folder already exists: {run_dir} (choose another --run)")
    os.makedirs(run_dir)
    log = os.path.join(run_dir, "sysmon.log")
    open(log, "a").close()        # so Alloy sees the file immediately; rsyslog then appends to it
    # rsyslog runs as user "syslog"; it must own the run dir + file to write Sysmon events into them.
    try:
        shutil.chown(run_dir, user="syslog", group="syslog")
        shutil.chown(log, user="syslog", group="syslog")
    except (LookupError, PermissionError):
        pass                       # non-root / no syslog user (e.g. a local test)
    tmp = CURRENT + ".new"
    if os.path.islink(tmp) or os.path.exists(tmp):
        os.remove(tmp)
    os.symlink(os.path.join(a.split, run), tmp)   # relative target: {raw_root}/<split>/<run>
    os.replace(tmp, CURRENT)                       # atomic repoint
    reload_rsyslog()
    write_state({"split": a.split, "run": run, "dir": run_dir, "started_utc": now(), "stopped_utc": None})
    print(f"[labctl] capturing {a.split}/{run} -> {run_dir}")
    cmd_status(a)


def cmd_stop(a):
    st = read_state()
    if st and not st.get("stopped_utc"):
        st["stopped_utc"] = now()
        write_state(st)
    cmd_status(a)


def cmd_status(a):
    st = read_state()
    svc = subprocess.run(["systemctl", "is-active", "sysmon"], capture_output=True, text=True).stdout.strip()
    print(f"sysmon  : {svc}")
    if st:
        print(f"run     : {st['split']}/{st['run']}  started {st['started_utc']}  stopped {st.get('stopped_utc')}")
        log = os.path.join(st["dir"], "sysmon.log")
        if os.path.exists(log):
            print(f"log     : {log}  {os.path.getsize(log)/1024:.0f} KB")


def main(argv=None):
    ap = argparse.ArgumentParser(description="Sysmon-for-Linux capture control")
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("start"); s.add_argument("--split", required=True, choices=["train", "test"]); s.add_argument("--run")
    sub.add_parser("stop")
    sub.add_parser("status")
    a = ap.parse_args(argv)
    {"start": cmd_start, "stop": cmd_stop, "status": cmd_status}[a.cmd](a)
    return 0


if __name__ == "__main__":
    sys.exit(main())
