// Generated by Ansible (ubuntu_collector role). Grafana Alloy on the Linux target: ship raw Sysmon-for-Linux
// lines to Loki on the trainer ({{ loki_url }}). The Linux counterpart of win_alloy/config.alloy.j2.
//
//   {{ linux_raw_root }}/<split>/<run>/sysmon.log   (rsyslog, one Sysmon XML event per line; labctl start)
//     -> labels      job="{{ sysmon_job }}", host, split, run, provider="sysmon"
//     -> metadata    event (EventID), pid, process                 (filterable, NOT indexed)
//     -> timestamp   the event's own Sysmon UtcTime (UTC), not the time Alloy read it
//     -> line        unchanged: Loki holds exactly what Sysmon wrote
// The same label scheme as SilkETW, so loki_pull.py --job sysmon and build_experiment.py --source sysmon
// consume it. [INFERENCE] confirm the Sysmon line/field shape on first provisioning (journalctl -t sysmon).

local.file_match "sysmon" {
  path_targets = [{
    "__path__" = "{{ linux_raw_root }}/*/*/sysmon.log",
    "job"      = "{{ sysmon_job }}",
    "host"     = "{{ inventory_hostname }}",
  }]
  sync_period = "2s"     // a new run folder is picked up within 2 s of labctl start
}

loki.source.file "sysmon" {
  targets       = local.file_match.sysmon.targets
  forward_to    = [loki.process.sysmon.receiver]
  tail_from_end = false  // new files are read from the start; positions survive restarts
}

loki.process "sysmon" {
  stage.regex {
    source     = "filename"
    expression = `/(?P<split>train|test)/(?P<run>[^/]+)/sysmon\.log$`
  }
  stage.labels {
    values = { split = "", run = "" }
  }
  stage.static_labels {
    values = { provider = "sysmon" }   // one provider on Linux (contrast kproc/kfile/knet on Windows)
  }
  // Sysmon UtcTime, e.g. <Data Name='UtcTime'>2026-10-19 05:00:00.123</Data>
  stage.regex {
    expression = `<Data Name=['"]UtcTime['"]>(?P<ts>[^<]+)</Data>`
  }
  stage.timestamp {
    source            = "ts"
    format            = "2006-01-02 15:04:05.000"
    location          = "UTC"
    action_on_failure = "skip"          // keep the read time; the converter counts such lines as bad
  }
  stage.regex {
    expression = `<EventID>(?P<event>\d+)</EventID>`
  }
  stage.regex {
    expression = `<Data Name=['"]ProcessId['"]>(?P<pid>\d+)</Data>`
  }
  stage.regex {
    expression = `<Data Name=['"]Image['"]>(?P<process>[^<]+)</Data>`
  }
  stage.structured_metadata {
    values = { event = "", pid = "", process = "" }
  }
  stage.label_drop {
    values = ["filename"]
  }
  forward_to = [loki.write.trainer.receiver]
}

// ---------------------------------------------------------------- push
loki.write "trainer" {
  endpoint {
    url        = "{{ loki_url }}/loki/api/v1/push"
    batch_wait = "1s"
    batch_size = "1MiB"
  }
}
