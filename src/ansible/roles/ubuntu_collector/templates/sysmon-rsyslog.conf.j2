# Generated by Ansible (ubuntu_collector role). Route Sysmon-for-Linux's syslog messages into the current
# capture run's file, the Linux equivalent of SilkService writing raw\<split>\<run>\<provider>.json.
#
# [INFERENCE] Sysmon-for-Linux logs each event to syslog tagged "sysmon"; confirm the programname on first
# provisioning (journalctl -t sysmon). "{{ linux_raw_root }}/current" is a symlink that labctl repoints to
# the active raw/<split>/<run>/ dir, then reloads rsyslog so it reopens the file. Alloy tails the real
# per-run path and derives split/run from it.
$FileCreateMode 0644
:programname, isequal, "sysmon"  -{{ linux_raw_root }}/current/sysmon.log
& stop
