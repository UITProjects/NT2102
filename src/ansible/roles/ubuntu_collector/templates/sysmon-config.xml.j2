<!-- Generated by Ansible (ubuntu_collector role). Sysmon-for-Linux capture config, the Linux counterpart of
     the SilkService Kernel-Process/File/Network collectors. onmatch="exclude" with no child rules = capture
     every event of that type (lab scale; the benign+attack graph is small). The converter sysmon2nodlink.py
     maps: ProcessCreate->Start, FileCreate->Write, RawAccessRead->Read, NetworkConnect->Send. There is no
     ImageLoad on Linux Sysmon, so no Load edges (see docs/DEVIATIONS.md). -->
<Sysmon schemaversion="4.81">
  <EventFiltering>
    <ProcessCreate onmatch="exclude"/>
    <ProcessTerminate onmatch="exclude"/>
    <NetworkConnect onmatch="exclude"/>
    <FileCreate onmatch="exclude"/>
    <RawAccessRead onmatch="exclude"/>
  </EventFiltering>
</Sysmon>
