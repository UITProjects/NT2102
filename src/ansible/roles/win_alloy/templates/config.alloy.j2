// Generated by Ansible (win_alloy role). Grafana Alloy: ship raw SilkETW lines to Loki on the trainer.
//
//   {{ raw_root }}\<split>\<run>\<provider>.json   (SilkService, one JSON event per line; etwctl start)
//     -> labels      job="silketw", host, split, run, provider   (few values: one stream per raw file)
//     -> metadata    event, pid, process                         (filterable, NOT indexed: pid would explode streams)
//     -> timestamp   the event's own TimeStamp (VM clock), not the time Alloy read it
//     -> line        unchanged: Loki holds exactly what SilkETW wrote
//   + dosmap.meta per run (job="etw-meta") and the benign-workload ledger CSVs (job="workload-ledger").
// The same label scheme is documented in src/pipeline/lokiclient.py and produced by src/live/loki_push.py.
// Alloy's own file reads show up in Kernel-File; the converter drops edges of image "alloy" (like silkservice).

// ---------------------------------------------------------------- SilkETW events
local.file_match "silketw" {
  path_targets = [{
    "__path__" = "{{ raw_root | replace('\\', '/') }}/*/*/*.json",
    "job"      = "silketw",
    "host"     = "{{ inventory_hostname }}",
  }]
  sync_period = "2s"     // a new run folder is picked up within 2 s of etwctl start
}

loki.source.file "silketw" {
  targets       = local.file_match.silketw.targets
  forward_to    = [loki.process.silketw.receiver]
  tail_from_end = false  // new files are read from the start; positions survive restarts
}

loki.process "silketw" {
  stage.regex {
    source     = "filename"
    expression = `[\\/](?P<split>train|test)[\\/](?P<run>[^\\/]+)[\\/](?P<provider>[A-Za-z0-9_-]+)\.json$`
  }
  stage.labels {
    values = { split = "", run = "", provider = "" }
  }
  stage.json {
    expressions = { ts = "TimeStamp", event = "EventName", pid = "ProcessID", process = "ProcessName" }
  }
  stage.timestamp {
    source            = "ts"
    format            = "RFC3339Nano"   // accepts SilkETW's 6-7 fractional digits and the +07:00 offset
    action_on_failure = "skip"          // keep the read time; the converter counts such lines as bad
  }
  stage.structured_metadata {
    values = { event = "", pid = "", process = "" }
  }
  stage.label_drop {
    values = ["filename"]
  }
  forward_to = [loki.write.trainer.receiver]
}

// ---------------------------------------------------------------- dos map per run (etwctl start)
local.file_match "etwmeta" {
  path_targets = [{
    "__path__" = "{{ raw_root | replace('\\', '/') }}/*/*/dosmap.meta",
    "job"      = "etw-meta",
    "host"     = "{{ inventory_hostname }}",
  }]
  sync_period = "2s"
}

loki.source.file "etwmeta" {
  targets       = local.file_match.etwmeta.targets
  forward_to    = [loki.process.etwmeta.receiver]
  tail_from_end = false
}

loki.process "etwmeta" {
  stage.regex {
    source     = "filename"
    expression = `[\\/](?P<split>train|test)[\\/](?P<run>[^\\/]+)[\\/]dosmap\.meta$`
  }
  stage.labels {
    values = { split = "", run = "" }
  }
  stage.label_drop {
    values = ["filename"]
  }
  forward_to = [loki.write.trainer.receiver]
}

// ---------------------------------------------------------------- benign workload ledger (06 via 07)
local.file_match "ledger" {
  path_targets = [{
    "__path__" = "{{ out_dir | replace('\\', '/') }}/experiments/*/labels/*.csv",
    "job"      = "workload-ledger",
    "host"     = "{{ inventory_hostname }}",
  }]
  sync_period = "10s"
}

loki.source.file "ledger" {
  targets       = local.file_match.ledger.targets
  forward_to    = [loki.process.ledger.receiver]
  tail_from_end = false
}

loki.process "ledger" {
  stage.regex {
    source     = "filename"
    expression = `[\\/]experiments[\\/](?P<exp>[^\\/]+)[\\/]labels[\\/]`
  }
  stage.labels {
    values = { exp = "" }
  }
  stage.regex {
    expression = `^"(?P<utc>\d{4}-[^"]+)"`   // first CSV column = action time (UTC); header line has none
  }
  stage.timestamp {
    source            = "utc"
    format            = "RFC3339Nano"
    action_on_failure = "skip"
  }
  stage.label_drop {
    values = ["filename"]
  }
  forward_to = [loki.write.trainer.receiver]
}

// ---------------------------------------------------------------- push
loki.write "trainer" {
  endpoint {
    url        = "{{ loki_url }}/loki/api/v1/push"
    batch_wait = "1s"
    batch_size = "1MiB"
  }
}
