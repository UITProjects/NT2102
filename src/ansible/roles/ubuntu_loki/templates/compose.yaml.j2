# Generated by Ansible (ubuntu_loki role). Loki + Grafana with host networking: they listen on the host's
# own interfaces, so the Windows VM reaches Loki at {{ private_ip }}:{{ loki_port }} and ufw guards both ports.
name: lokistack
services:
  loki:
    image: {{ loki_image }}
    network_mode: host
    command: ["-config.file=/etc/loki/loki.yaml"]
    volumes:
      - ./loki.yaml:/etc/loki/loki.yaml:ro
      - loki-data:/loki
    restart: unless-stopped

  grafana:
    image: {{ grafana_image }}
    network_mode: host
    environment:
      GF_SERVER_HTTP_PORT: "{{ grafana_port }}"
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana
    depends_on: [loki]
    restart: unless-stopped

volumes:
  loki-data:
  grafana-data:
