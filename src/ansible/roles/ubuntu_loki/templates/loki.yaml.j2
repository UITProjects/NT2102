# Generated by Ansible (ubuntu_loki role). Single-binary Loki, filesystem storage, one tenant.
# Sized for one lab VM: ~230 MB of raw ETW per 20-min capture, a few hundred lines/s live.
auth_enabled: false

server:
  http_listen_address: 0.0.0.0        # host network: ufw restricts {{ loki_port }} to the Windows collector
  http_listen_port: {{ loki_port }}
  grpc_listen_address: 127.0.0.1
  grpc_listen_port: 9096
  grpc_server_max_recv_msg_size: 16777216   # 16 MiB: a push is forwarded internally over gRPC (default 4 MiB)
  grpc_server_max_send_msg_size: 16777216
  log_level: warn

common:
  instance_addr: 127.0.0.1
  path_prefix: /loki
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules

schema_config:
  configs:
    - from: "2024-04-01"
      store: tsdb
      object_store: filesystem
      schema: v13                     # needed for structured metadata (event, pid, process)
      index:
        prefix: index_
        period: 24h

limits_config:
  allow_structured_metadata: true
  reject_old_samples: true
  reject_old_samples_max_age: {{ loki_retention }}   # a capture shipped late (Alloy was down) is still accepted
  retention_period: {{ loki_retention }}
  max_entries_limit_per_query: 50000                 # loki_pull.py pages by 5000 by default
  # live: ~0.2 MB/s. A backlog (Alloy was down, or loki_push.py) arrives as fast as Loki takes it; above
  # these limits Loki answers 429 and Alloy / loki_push.py retry with backoff, so nothing is lost.
  ingestion_rate_mb: 32
  ingestion_burst_size_mb: 64
  per_stream_rate_limit: 16MB
  per_stream_rate_limit_burst: 64MB
  max_query_length: 0                                # pulls may span the whole retention
  shard_streams:
    enabled: false   # one stream per raw file: auto-sharding splits it, and Loki then keeps re-sent identical
                     # lines (dedup only works inside one shard)

ingester:
  # Observed on Loki 3.7.8: lines with an OLD event time (a backlog Alloy ships late, a loki_push.py replay)
  # are not returned by queries while they sit in an unflushed in-memory chunk; after the flush they are.
  # Live streams are recent and unaffected. Flushing idle chunks after 2 min (default 30) bounds that gap.
  chunk_idle_period: 2m
  wal:
    enabled: true
    dir: /loki/wal                   # on the volume: lines not yet flushed survive a restart
    flush_on_shutdown: true

query_range:
  # No result caching: Loki caches results for ranges older than 10 min, so a query that ran while a backlog
  # was still arriving (old event times) would keep answering with the partial result. Lab scale: not needed.
  cache_results: false
  cache_series_results: false
  cache_label_results: false
  cache_volume_results: false
  cache_index_stats_results: false
  cache_instant_metric_results: false

querier:
  query_ingesters_within: 0   # always ask the ingester too (default 3h), for recently pushed lines of any age

compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  delete_request_store: filesystem

analytics:
  reporting_enabled: false
