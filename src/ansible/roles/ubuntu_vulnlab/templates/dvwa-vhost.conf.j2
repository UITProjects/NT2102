# Generated by Ansible (ubuntu_vulnlab role). DVWA served at the DocumentRoot on {{ vulnlab_port }}, so the
# exploit path stays /vulnerabilities/exec/ (no /DVWA prefix) — identical to the Windows XAMPP vhost.
<VirtualHost *:{{ vulnlab_port }}>
    DocumentRoot {{ linux_vulnlab_dir }}

    <Directory {{ linux_vulnlab_dir }}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/dvwa_error.log
    CustomLog ${APACHE_LOG_DIR}/dvwa_access.log combined
</VirtualHost>
