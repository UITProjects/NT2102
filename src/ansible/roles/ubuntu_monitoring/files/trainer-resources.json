      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  }
 ],
 "description": "CPU, memory, disk and network of ubuntu-trainer, and of ocr-live and the containers on it. Managed by Ansible."
}