     "editorMode": "code",
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (name) (container_memory_rss{name!=\"\"})",
     "legendFormat": "{{name}}",
     "refId": "B",
     "editorMode": "code",
     "range": true
