# Generated by Ansible (ubuntu_monitoring role): Grafana -> Prometheus on the same host. Loki stays the default.
apiVersion: 1
datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://127.0.0.1:{{ prometheus_port }}
    isDefault: false
    jsonData:
      timeInterval: {{ prometheus_scrape_interval }}
