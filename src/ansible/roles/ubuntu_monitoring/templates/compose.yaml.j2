# Generated by Ansible (ubuntu_monitoring role). Host network like lokistack; every service binds 127.0.0.1.
name: monitoring
services:
  prometheus:
    image: {{ prometheus_image }}
    mem_reservation: {{ monitoring_mem.prometheus.reservation }}m
    mem_limit: {{ monitoring_mem.prometheus.limit }}m
    memswap_limit: {{ monitoring_mem.prometheus.limit }}m   # = mem_limit: no swap, graphs stay fast
    cpu_shares: {{ monitoring_cpu_shares }}
    oom_score_adj: {{ monitoring_oom_score_adj }}
    network_mode: host
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ prometheus_retention_time }}
      - --storage.tsdb.retention.size={{ prometheus_retention_size }}
      - --web.listen-address=127.0.0.1:{{ prometheus_port }}
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    restart: unless-stopped

  node-exporter:
    image: {{ node_exporter_image }}
    mem_reservation: {{ monitoring_mem.node_exporter.reservation }}m
    mem_limit: {{ monitoring_mem.node_exporter.limit }}m
    memswap_limit: {{ monitoring_mem.node_exporter.limit }}m   # = mem_limit: no swap, graphs stay fast
    cpu_shares: {{ monitoring_cpu_shares }}
    oom_score_adj: {{ monitoring_oom_score_adj }}
    network_mode: host
    pid: host
    command:
      - --path.rootfs=/host
      - --web.listen-address=127.0.0.1:{{ node_exporter_port }}
    volumes:
      - /:/host:ro,rslave
    restart: unless-stopped

  cadvisor:
    image: {{ cadvisor_image }}
    mem_reservation: {{ monitoring_mem.cadvisor.reservation }}m
    mem_limit: {{ monitoring_mem.cadvisor.limit }}m
    memswap_limit: {{ monitoring_mem.cadvisor.limit }}m   # = mem_limit: no swap, graphs stay fast
    cpu_shares: {{ monitoring_cpu_shares }}
    oom_score_adj: {{ monitoring_oom_score_adj }}
    network_mode: host
    privileged: true          # reads every cgroup, not only containers: that is how ocr-live.service gets its numbers
    cgroup: host
    command:
      - --listen_ip=127.0.0.1
      - --port={{ cadvisor_port }}
      - --docker_only=false
      - --housekeeping_interval={{ prometheus_scrape_interval }}
      - --store_container_labels=false
      - --enable_metrics=cpu,memory   # the dashboard needs no more; this also stops its disk-usage scans of Docker
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
    healthcheck:              # the image's own check probes 8080 whatever --port says
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:{{ cadvisor_port }}/healthz"]
      interval: 30s
      timeout: 3s
      start_period: 5s
    restart: unless-stopped

volumes:
  prometheus-data:
