# Generated by Ansible (ubuntu_monitoring role). Limits for everything run over SSH, training included.
# Past MemoryHigh the slice is slowed and pushed to swap. MemoryMax is the most RAM it can hold. When RAM and
# MemorySwapMax are both used up, the kernel kills inside this slice only.
[Slice]
MemoryHigh={{ training_memory_high }}M
MemoryMax={{ training_memory_max }}M
MemorySwapMax={{ training_swap_max_gib }}G
CPUWeight=20
CPUQuota={{ training_cpu_quota }}
IOWeight=20
