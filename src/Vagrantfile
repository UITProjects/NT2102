# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Two-machine ETW lab — OCR-APT reproduction (NT2102). Provisioned by Ansible, not Vagrant.
#
#   ws-etw          Windows Server 2022   10.21.2.10   collector + shipper + benign workload + DVWA
#                                                      vulnlab. Pushes raw ETW only; runs no training.
#   ubuntu-trainer  Ubuntu 24.04          10.21.2.20   clones the repo, uv sync, runs live_server.py.
#                                                      Receives the pushed data; holds training + demo.
#   kali            Kali Rolling          10.21.2.30   attacker: exploits DVWA + delivers the RCE
#                                                      kill chain (src/atomic-attack-pack). Same subnet.
#
# Both VMs sit on one host-only network (10.21.2.0/24, host side = 10.21.2.1). The Windows shipper posts
# to the Ubuntu VM over this network; the browser UI is opened from the host at 10.21.2.20:8000.
# These 10.21.2.x values are the LOCAL lab only. On cloud the same Ansible runs against a different
# inventory (src/ansible/inventory.cloud.ini) — see src/ansible/README.md.
#
# Network layout (per VM)
#   Adapter 1 = NAT (Vagrant management + internet for tool/apt/npm downloads)
#   Adapter 2 = host-only (lab network, static IP below .128 so it never hits the DHCP pool .128-.254)
#
# Workflow
#   ./host-setup.sh                            # one-time host prep (networks.conf, KVM check)
#   vagrant up                                 # build both bare VMs (NAT on)
#   # Windows only: turn OFF Tamper Protection in Windows Security GUI (see src/ansible/README.md)
#   (cd ansible && ansible-playbook site.yml)  # install + configure both VMs
#   vagrant snapshot save clean-baseline
#   LAB_ISOLATED=1 vagrant reload ws-etw       # Windows NAT unplugged: host-only only (attack runs)
#   vagrant snapshot restore ws-etw clean-baseline  # before each attack run

LAB_SUBNET  = "10.21.2"
WIN_IP      = "#{LAB_SUBNET}.10"
UBUNTU_IP   = "#{LAB_SUBNET}.20"
KALI_IP     = "#{LAB_SUBNET}.30"
WIN_NAME    = "ws-etw"           # Windows hostnames: max 15 chars
UBUNTU_NAME = "ubuntu-trainer"
KALI_NAME   = "kali"
# Only the Windows VM's NAT is cut in isolated mode (it runs the attack tooling). Ubuntu is the trainer
# and keeps its NAT so it can still pull packages; it never runs attacks.
ISOLATED    = ENV.fetch("LAB_ISOLATED", "0") == "1"

Vagrant.configure("2") do |config|
  # Never expose the whole project dir to a VM; Ubuntu gets the repo via git clone. The one narrow
  # exception is the Kali attacker below, which mounts ONLY src/atomic-attack-pack (its own tooling).
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # ------------------------------------------------------------------ Windows Server 2022 collector VM
  config.vm.define WIN_NAME do |win|
    win.vm.box            = "gusztavvargadr/windows-server-2022-standard"   # evaluation (180-day) box
    win.vm.box_version    = "2607.0.0"
    win.vm.hostname       = WIN_NAME
    win.vm.guest          = :windows
    win.vm.communicator   = "winrm"
    win.vm.boot_timeout   = 1800
    win.winrm.timeout     = 1800
    win.winrm.retry_limit = 30

    # Host-only NIC. Vagrant creates/reuses a vboxnetN whose host IP is 10.21.2.1.
    win.vm.network "private_network", ip: WIN_IP, netmask: "255.255.255.0"

    if ISOLATED
      # NAT is unplugged, so the NAT port-forward is dead: reach WinRM over the host-only IP.
      win.winrm.host = WIN_IP
      win.winrm.port = 5985
    end

    win.vm.provider "virtualbox" do |vb|
      vb.name   = WIN_NAME
      vb.gui    = true
      vb.memory = 8096
      vb.cpus   = 4
      vb.customize ["modifyvm", :id, "--graphicscontroller", "vboxsvga"]
      vb.customize ["modifyvm", :id, "--accelerate3d", "off"]
      vb.customize ["modifyvm", :id, "--vram", "256"]
      vb.customize ["modifyvm", :id, "--clipboard-mode", "bidirectional"]
      vb.customize ["modifyvm", :id, "--draganddrop", "disabled"]
      vb.customize ["modifyvm", :id, "--cableconnected1", ISOLATED ? "off" : "on"]
      # Audio
      audio_driver =
        if Vagrant::Util::Platform.windows?
          "was" # Windows Audio Session API; use "dsound" on older VirtualBox
        elsif Vagrant::Util::Platform.darwin?
          "coreaudio"
        else
          "pulse" # Ubuntu: PulseAudio/PipeWire; use "alsa" if no sound server
        end
      vb.customize ["modifyvm", :id, "--audio-enabled", "on"]
      vb.customize ["modifyvm", :id, "--audio-driver", audio_driver]
      vb.customize ["modifyvm", :id, "--audio-controller", "hda"]
      vb.customize ["modifyvm", :id, "--audio-out", "on"]
      vb.customize ["modifyvm", :id, "--audio-in", "off"]
    end
  end

  # ------------------------------------------------------------------ Ubuntu trainer / live-server VM
  config.vm.define UBUNTU_NAME do |ub|
    ub.vm.box          = "bento/ubuntu-24.04"
    ub.vm.hostname     = UBUNTU_NAME
    ub.vm.boot_timeout = 600

    ub.vm.network "private_network", ip: UBUNTU_IP, netmask: "255.255.255.0"

    ub.vm.provider "virtualbox" do |vb|
      vb.name   = UBUNTU_NAME
      vb.gui    = false
      vb.memory = 4096     # torch / torch-geometric training + live scoring
      vb.cpus   = 2
    end
  end

  # ------------------------------------------------------------------ Kali attacker VM
  # Keeps its NAT (like Ubuntu) so apt works; attacks ws-etw only over the host-only subnet. Only the
  # Windows VM's NAT is cut in LAB_ISOLATED, so leave Kali's cable connected.
  config.vm.define KALI_NAME do |kali|
    kali.vm.box          = "kalilinux/rolling"
    kali.vm.hostname     = KALI_NAME
    kali.vm.boot_timeout = 600

    kali.vm.network "private_network", ip: KALI_IP, netmask: "255.255.255.0"

    # Deliver the attack pack by mount (NOT Ansible): the operator runs the launcher straight from here,
    #   python3 -I /opt/attack-pack/tools/launch_exploit.py --target http://10.21.2.10:3000
    # Read-only: the attacker only reads its tooling. If the kalilinux/rolling box lacks VirtualBox guest
    # additions (vboxsf mount fails), change this to  type: "rsync"  (drop mount_options).
    kali.vm.synced_folder "atomic-attack-pack", "/opt/attack-pack"

    kali.vm.provider "virtualbox" do |vb|
      vb.name   = KALI_NAME
      vb.gui    = false
      vb.memory = 2048
      vb.cpus   = 2
    end
  end
end
