# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Windows 10 ETW collection lab — OCR-APT reproduction (NT2102)
#
# Network layout
#   Host-only 10.21.2.0/24, host side (vboxnetN) = 10.21.2.1 (the "gateway")
#   VM static IP = 10.21.2.10  (below .128, so it never collides with the DHCP pool .128-.254)
#   Adapter 1 = NAT (Vagrant management + internet for tool downloads)
#   Adapter 2 = host-only (lab network)
#
# Workflow
#   ./host-setup.sh                         # one-time host prep (networks.conf, KVM check)
#   vagrant up                              # build + provision (NAT on)
#   # >>> turn OFF Tamper Protection in Windows Security GUI, then: vagrant provision --provision-with base
#   vagrant snapshot save clean-baseline
#   LAB_ISOLATED=1 vagrant reload           # NAT unplugged: host-only only (benign capture + attack runs)
#   vagrant snapshot restore clean-baseline # before each attack run

LAB_SUBNET = "10.21.2"
VM_IP      = "#{LAB_SUBNET}.10"
VM_NAME    = "w10-etw"          # Windows hostnames: max 15 chars
ISOLATED   = ENV.fetch("LAB_ISOLATED", "0") == "1"

Vagrant.configure("2") do |config|
  config.vm.box            = "gusztavvargadr/windows-10"   # Win10 evaluation box; verify version on the box page
  config.vm.hostname       = VM_NAME
  config.vm.guest          = :windows
  config.vm.communicator   = "winrm"
  config.vm.boot_timeout   = 1800
  config.winrm.timeout     = 1800
  config.winrm.retry_limit = 30

  # Host-only NIC. Vagrant creates/reuses a vboxnetN whose host IP is 10.21.2.1.
  config.vm.network "private_network", ip: VM_IP, netmask: "255.255.255.0"

  # Never expose the project dir to a VM that will run attack tooling.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  if ISOLATED
    # NAT is unplugged, so the NAT port-forward is dead: reach WinRM over the host-only IP.
    config.winrm.host = VM_IP
    config.winrm.port = 5985
  else
    # Export channel for traces/provider dumps while NOT isolated.
    config.vm.synced_folder "./out", "C:/lab-out", create: true
  end

  config.vm.provider "virtualbox" do |vb|
    vb.name   = VM_NAME
    vb.gui    = true
    vb.memory = 4096
    vb.cpus   = 4
    vb.customize ["modifyvm", :id, "--vram", "128"]
    vb.customize ["modifyvm", :id, "--clipboard-mode", "bidirectional"]
    vb.customize ["modifyvm", :id, "--draganddrop", "disabled"]
    vb.customize ["modifyvm", :id, "--cableconnected1", ISOLATED ? "off" : "on"]
  end

  config.vm.provision "base",  type: "shell", path: "scripts/01-base.ps1",  privileged: true, args: [VM_IP]
  config.vm.provision "tools", type: "shell", path: "scripts/02-tools.ps1", privileged: true
  config.vm.provision "workload", type: "shell", path: "scripts/03-workload.ps1",privileged: true,
  args: ["-PgPassword", ENV.fetch("LAB_PG_PASSWORD", "labpg-ChangeMe!"), "-Extras"]
end