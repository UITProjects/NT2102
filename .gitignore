# Vagrant state (per-clone, machine-local)
.vagrant/

# Per-VM dedicated data disks — captures, flows, DVWA state, MySQL data, etc.
# Ignored so they don't bloat Git; each teammate has their own after `vagrant up`.
.vm-data/

# OS junk
.DS_Store
Thumbs.db
*.swp
*~
/datasets/

dataset.tar.xz
.idea
/src/out/

# Large local data and live session logs (raw ETW, can be GBs)
/dataset/
/original-dataset/
/src/live/sessions/
__pycache__/

# Ansible lab secrets and local artefacts
/src/ansible/group_vars/vault.yml
/src/ansible/inventory.cloud.ini
/src/ansible/*.retry
/src/ansible/.vault-pass
/src/ansible/.venv/
